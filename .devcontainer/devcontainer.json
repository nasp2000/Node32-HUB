{
  "name": "Node32-HUB firmware",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "platformio.platformio-ide",
        "ms-vscode.cpptools",
        "ms-python.python"
      ]
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y g++ make && pip install platformio && cd tests/web && npm ci || true",
  "remoteUser": "vscode"
}
