{
  "_comment": "Release targets: variant -> existing GitHub repo. Only variants listed in .github/workflows/release.yml -> inputs.variant.options can be dispatched; entries here that are commented out there are prepared but disabled. A target repo may host several variants (Cam-M: S3 + P4, GcodeSender: P4 + S3) — each variant needs its own tag_suffix so tags/assets do not collide. Node32-OEE (pack WAVESHARE) intentionally has NO release target.",
  "variants": {
    "CAM_S3": {
      "repo": "nasp2000/Cam-M",
      "product": "Cam-M",
      "variant": "ESP32-S3 N16R8",
      "env": "n16r8",
      "pack": "CAM",
      "flags": "-DSELECTED_PACK=PACK_CAM -DTARGET_BOARD_S3_CAM=1",
      "tag_suffix": "",
      "title_suffix": "",
      "scopes": [
        "cam",
        "camera",
        "cam-m",
        "cam_m",
        "mjpeg"
      ],
      "paths": [
        "chatgpt/packs/pack_cam.h",
        "chatgpt/src/camera_*",
        "chatgpt/src/interfaces/ICameraController.h",
        "chatgpt/src/webpages/**/*camera*",
        "PAGES/camera.md"
      ]
    },
    "CAM_P4": {
      "repo": "nasp2000/Cam-M",
      "product": "Cam-M",
      "variant": "ESP32-P4",
      "env": "esp32p4cam",
      "pack": "CAM_P4",
      "flags": "-DSELECTED_PACK=PACK_CAM_P4",
      "tag_suffix": "-p4",
      "title_suffix": " (ESP32-P4)",
      "scopes": [
        "cam",
        "camera",
        "cam-p4",
        "cam_p4",
        "mjpeg"
      ],
      "paths": [
        "chatgpt/packs/pack_cam_p4.h",
        "chatgpt/src/camera_*",
        "chatgpt/src/interfaces/ICameraController.h",
        "chatgpt/src/webpages/**/*camera*",
        "PAGES/camera.md"
      ]
    },
    "RAMBOX": {
      "repo": "nasp2000/Rambox32",
      "product": "Rambox32",
      "variant": "ESP32-S3 N16R8",
      "env": "n16r8",
      "pack": "RAMBOX",
      "flags": "-DSELECTED_PACK=PACK_RAMBOX",
      "tag_suffix": "",
      "title_suffix": "",
      "scopes": [
        "rambox",
        "rs232",
        "modbus",
        "unikon",
        "bricon",
        "lpt"
      ],
      "paths": [
        "chatgpt/packs/pack_rambox.h",
        "chatgpt/src/rs232_*",
        "chatgpt/src/modbus*",
        "chatgpt/src/rambox_*",
        "chatgpt/src/unikon_*",
        "chatgpt/src/bricon_*",
        "chatgpt/src/lpt_*",
        "chatgpt/src/webpages/**/*rambox*",
        "PAGES/rambox.md",
        "PAGES/rs232.md",
        "PAGES/bricon.md",
        "PAGES/lpt_db25.md"
      ]
    },
    "RADIO": {
      "repo": "nasp2000/Harmonica-BOX",
      "product": "Harmonica Box",
      "variant": "ESP32-S3 N16R8",
      "env": "n16r8",
      "pack": "RADIO",
      "flags": "-DSELECTED_PACK=PACK_RADIO",
      "tag_suffix": "",
      "title_suffix": "",
      "scopes": [
        "radio",
        "audio",
        "harmonica",
        "i2s",
        "upnp",
        "icy",
        "mp3",
        "flac"
      ],
      "paths": [
        "chatgpt/packs/pack_radio.h",
        "chatgpt/src/audio_*",
        "chatgpt/src/radio_*",
        "chatgpt/src/upnp_*",
        "chatgpt/src/icy_*",
        "chatgpt/src/webpages/**/*radio*",
        "PAGES/radio_ui.md"
      ]
    },
    "P4_CNC": {
      "repo": "nasp2000/GcodeSender",
      "product": "GcodeSender",
      "variant": "ESP32-P4",
      "env": "esp32p4",
      "pack": "P4_CNC",
      "flags": "-DSELECTED_PACK=PACK_P4_CNC",
      "tag_suffix": "",
      "title_suffix": "",
      "scopes": [
        "grbl",
        "p4-cnc",
        "p4_cnc",
        "gcode",
        "usb"
      ],
      "paths": [
        "chatgpt/packs/pack_p4_cnc.h",
        "chatgpt/src/grbl_*",
        "chatgpt/src/usb_*",
        "chatgpt/src/cnc_*",
        "chatgpt/src/webpages/**/*gcode*",
        "PAGES/grbl_controller.md",
        "PAGES/ipg_laser.md"
      ]
    },
    "S3_CNC": {
      "repo": "nasp2000/GcodeSender",
      "product": "GcodeSender S3",
      "variant": "ESP32-S3 N16R8",
      "env": "n16r8",
      "pack": "S3_CNC",
      "flags": "-DSELECTED_PACK=PACK_S3_CNC",
      "tag_suffix": "-s3",
      "title_suffix": " (ESP32-S3)",
      "scopes": [
        "grbl",
        "s3-cnc",
        "s3_cnc",
        "gcode",
        "usb"
      ],
      "paths": [
        "chatgpt/packs/pack_s3_cnc_usb.h",
        "chatgpt/src/grbl_*",
        "chatgpt/src/usb_*",
        "chatgpt/src/webpages/**/*gcode*",
        "PAGES/grbl_controller.md"
      ]
    }
  }
}
