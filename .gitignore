# ⚙️ Ficheiro .gitignore para projeto ESP32/Arduino
# 📦 Exclui builds, binários e ficheiros temporários

# Arduino/PlatformIO builds
.pio/
.pio-linux/
.pio-p4cam/
.vscode/
.pioenvs/
.piolibdeps/
# P4-CAM isolated debug scaffold (temporary wrapper, remove on migration)
build_p4cam.sh
.clang_complete
.gcc-flags.json
*.bin
*.elf
*.hex
*.map

# Build artifacts
*.a
*.so
*.d
*.exe
# Coverage artifacts
*.gcov
*.gcda
*.gcno

# Non-compilation repository content
Docs/
Others/
chatgpt.code-workspace
flash_fix.bat
flash_fix.ps1

# Logs e debug
*.log
*.tmp
*.temp

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.directory

# IDE
.idea/
*.iml
*.sublime-project
*.sublime-workspace

# Credenciais e configurações sensíveis
secrets.h
credentials.h
passwords.txt

# Backups
*.bak
*.backup
*_backup.*

# Test executables (native test temp artifacts)
*.exe.tmp*
# Native test binaries — Windows builds test_*.exe, Linux builds test_<name>
tests/native/test_*
!tests/native/test_*.cpp

# Local repo mirrors (not source-controlled)
REPOS/

# Local scratch / test plan markdown
test.md

# Python (para scripts auxiliares)
__pycache__/
*.pyc
*.pyo
*.egg-info/
venv/
.env

# Node modules (caso existam)
node_modules/

# Ferramentas auxiliares locais (não essenciais para compilar)
util/

# Build logs (generated by pre-scripts)
logs/

# Last build selection (build_firmware.bat / build_firmware.sh)
.build_firmware.last

# Agent instructions — local workflow only, never in any remote
.opencode/agents/
agents/

# Pack history (per-pack HISTORICO.md) — kept local, never committed
HISTORIC/

# tests/native generated stub copies (created by Makefile from production sources)
tests/native/*_stub.cpp
tests/native/*_stub.h
# Native test intermediate objects (compiled from prod sources; never commit)
tests/native/*.o
# NTP persistence test: massaged copy of NtpManager.cpp (timezone rename), generated by Makefile
tests/native/ntp_manager_linux.cpp

# Web-based tests (jsdom/Playwright) — version sources + fixtures only.
# Generated weight stays local: npm tree, run logs, screenshots, bytecode.
tests/web/node_modules/
tests/web/logs/
tests/web/shots/
tests/web/__pycache__/

# Análise / todo local
# todo.md is now tracked (see project roadmap)

# Ficheiros de sistema do Windows
$RECYCLE.BIN/
ehthumbs.db

# GitHub Actions (disabled via .gitignore)
.github/workflows/*

# LGPL compliance materials — generated on demand by chatgpt/scripts/package_third_party.py
third-party/
